    <!-- Procedural Generation & Logic -->
    <script>
        // --- 1. Math & Color Utilities ---
        const rRange = (min, max) => Math.random() * (max - min) + min;
        const rInt = (min, max) => Math.floor(rRange(min, max + 1));
        const rPastel = (hueStart, hueEnd, sStart=40, sEnd=70, lStart=75, lEnd=90) => 
            `hsl(${rRange(hueStart, hueEnd)}, ${rRange(sStart, sEnd)}%, ${rRange(lStart, lEnd)}%)`;

        // --- 2. Procedural SVG Generators ---
        
        // Generator: Eucalyptus (Curved branch, alternating round leaves)
        function createEucalyptusSVG() {
            let svg = `<svg width="120" height="240" viewBox="0 0 120 240" xmlns="http://www.w3.org/2000/svg">`;
            
            // Stem curve
            let startX = 60, startY = 230;
            let endX = 60 + rRange(-20, 20);
            let endY = 20;
            let cpX = 60 + rRange(-40, 40);
            
            svg += `<path d="M${startX},${startY} Q${cpX},120 ${endX},${endY}" stroke="#7e9680" stroke-width="3" fill="none" stroke-linecap="round"/>`;
            
            // Leaves along the stem
            let numLeaves = rInt(10, 16);
            let hueBase = rRange(130, 160); // Greens/Teals
            
            for(let i=0; i<numLeaves; i++) {
                let t = i / numLeaves; // 0 to 1 along curve
                // Approx point on quadratic bezier
                let lx = (1-t)*(1-t)*startX + 2*(1-t)*t*cpX + t*t*endX;
                let ly = (1-t)*(1-t)*startY + 2*(1-t)*t*120 + t*t*endY;
                
                let isLeft = i % 2 === 0;
                let xOffset = isLeft ? rRange(-20, -10) : rRange(10, 20);
                let rot = isLeft ? rRange(15, 45) : rRange(-45, -15);
                let lColor = rPastel(hueBase-10, hueBase+10, 20, 40, 60, 80);
                
                // Leaf size gets smaller near top
                let sizeScale = 1 - (t * 0.5);
                let rx = rRange(15, 25) * sizeScale;
                let ry = rRange(12, 18) * sizeScale;
                
                svg += `<g transform="translate(${lx}, ${ly}) rotate(${rot})">
                            <path d="M0,0 Q${xOffset},${ry} ${xOffset*1.5},0 Q${xOffset},${-ry} 0,0" fill="${lColor}" opacity="0.9"/>
                        </g>`;
            }
            svg += `</svg>`;
            return svg;
        }

        // Generator: Hydrangea (Cluster of small 4-petal flowers)
        function createHydrangeaSVG() {
            let svg = `<svg width="160" height="160" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg">`;
            
            // Base shadow/leaves
            svg += `<circle cx="80" cy="80" r="50" fill="#7e9680" opacity="0.4"/>`;
            
            let isPink = Math.random() > 0.5;
            let hueBase = isPink ? rRange(320, 350) : rRange(200, 230);
            
            let numFlowers = rInt(35, 50);
            
            for(let i=0; i<numFlowers; i++) {
                // Distribute within a circle using square root to avoid center clustering
                let r = Math.sqrt(Math.random()) * 55;
                let theta = Math.random() * Math.PI * 2;
                let cx = 80 + r * Math.cos(theta);
                let cy = 80 + r * Math.sin(theta);
                
                let fColor = rPastel(hueBase-15, hueBase+15, 50, 80, 75, 90);
                let fColorDark = rPastel(hueBase-15, hueBase+15, 60, 80, 65, 80);
                
                let rot = rRange(0, 90);
                
                // 4 Petals per mini flower
                svg += `<g transform="translate(${cx}, ${cy}) rotate(${rot}) scale(${rRange(0.8, 1.2)})">
                            <circle cx="-5" cy="0" r="6" fill="${fColor}" opacity="0.9"/>
                            <circle cx="5" cy="0" r="6" fill="${fColor}" opacity="0.9"/>
                            <circle cx="0" cy="-5" r="6" fill="${fColor}" opacity="0.9"/>
                            <circle cx="0" cy="5" r="6" fill="${fColor}" opacity="0.9"/>
                            <circle cx="0" cy="0" r="2.5" fill="#fdf0d5" fill-opacity="0.9"/>
                        </g>`;
            }
            svg += `</svg>`;
            return svg;
        }

        // Generator: Lily (Trumpet petals radiating from center)
        function createLilySVG() {
            let svg = `<svg width="180" height="180" viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">`;
            
            // Leaf backings
            svg += `<path d="M90,90 Q40,150 20,160 Q60,130 90,90" fill="#a3b18a"/>`;
            svg += `<path d="M90,90 Q140,150 160,160 Q120,130 90,90" fill="#a3b18a"/>`;

            let hueBase = rRange(30, 60); // Yellow/Cream base, sometimes slight pink
            if(Math.random() > 0.7) hueBase = rRange(330, 350);
            
            let colorBase = rPastel(hueBase-10, hueBase+10, 30, 60, 85, 95);
            let colorMid = rPastel(hueBase, hueBase+20, 60, 90, 70, 85);
            
            // 6 Petals
            for(let i=0; i<6; i++) {
                let rot = i * 60 + rRange(-5, 5);
                let sc = rRange(0.9, 1.1);
                svg += `<g transform="translate(90, 90) rotate(${rot}) scale(${sc})">
                            <path d="M0,0 Q30,-40 0,-85 Q-30,-40 0,0" fill="${colorBase}" stroke="${colorMid}" stroke-width="0.5"/>
                            <path d="M0,0 Q5,-30 0,-70" stroke="${colorMid}" stroke-width="1.5" fill="none" opacity="0.6"/>
                        </g>`;
            }
            
            // Stamens
            for(let i=0; i<5; i++) {
                let rot = i * 72 + rRange(-15, 15);
                let len = rRange(30, 45);
                svg += `<g transform="translate(90, 90) rotate(${rot})">
                            <line x1="0" y1="0" x2="0" y2="-${len}" stroke="#8ab092" stroke-width="1.5"/>
                            <ellipse cx="0" cy="-${len}" rx="2" ry="4" fill="#d4a373" transform="rotate(${rRange(-30,30)} 0 -${len})"/>
                        </g>`;
            }
            svg += `</svg>`;
            return svg;
        }

        // --- 3. App Logic & Interaction ---
        
        let zIndexCounter = 10;
        let selectedItem = null;

        function generateAndPlace(type) {
            let svgString = '';
            if(type === 'eucalyptus') svgString = createEucalyptusSVG();
            else if(type === 'hydrangea') svgString = createHydrangeaSVG();
            else if(type === 'lily') svgString = createLilySVG();

            const container = document.getElementById('items-layer');
            const el = document.createElement('div');
            el.className = 'placed-item flex items-center justify-center';
            
            // Encode SVG string to data URI to set as innerHTML directly avoids external fetching completely
            el.innerHTML = svgString;
            
            // Initial positioning (center of pot surface)
            el.style.left = '50%';
            el.style.top = '20%';
            el.style.zIndex = zIndexCounter++;
            
            // Transform states
            el.dataset.rot = rInt(-15, 15);
            el.dataset.scl = 1;
            updateTransform(el);

            // Drag setup
            makeDraggable(el);
            
            container.appendChild(el);
            selectItem(el);
        }

        function updateTransform(el) {
            // Translate is handled by absolute left/top to avoid transform origin complexities during drag.
            // Only rotate and scale are in transform.
            el.style.transform = `translate(-50%, -50%) rotate(${el.dataset.rot}deg) scale(${el.dataset.scl})`;
        }

        function selectItem(el) {
            if (selectedItem) selectedItem.classList.remove('selected');
            selectedItem = el;
            selectedItem.classList.add('selected');
            document.getElementById('floating-toolbar').classList.remove('hidden');
        }

        function deselectAll() {
            if (selectedItem) selectedItem.classList.remove('selected');
            selectedItem = null;
            document.getElementById('floating-toolbar').classList.add('hidden');
        }

        // Click outside to deselect
        document.getElementById('stage-bg').addEventListener('pointerdown', (e) => {
            if (e.target.id === 'stage-bg' || e.target.id === 'canvas-container' || e.target.id === 'pot-body') {
                deselectAll();
            }
        });

        function makeDraggable(el) {
            let startX, startY, initialLeft, initialTop;

            el.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                e.stopPropagation();
                selectItem(el);
                
                // Bring to front on tap
                el.style.zIndex = zIndexCounter++;

                el.setPointerCapture(e.pointerId);
                
                startX = e.clientX;
                startY = e.clientY;
                
                // Parse current left/top (assumes percentage or px)
                const rect = el.parentElement.getBoundingClientRect();
                initialLeft = el.offsetLeft;
                initialTop = el.offsetTop;

                const onPointerMove = (ev) => {
                    const dx = ev.clientX - startX;
                    const dy = ev.clientY - startY;
                    el.style.left = `${initialLeft + dx}px`;
                    el.style.top = `${initialTop + dy}px`;
                };

                const onPointerUp = (ev) => {
                    el.releasePointerCapture(ev.pointerId);
                    el.removeEventListener('pointermove', onPointerMove);
                    el.removeEventListener('pointerup', onPointerUp);
                };

                el.addEventListener('pointermove', onPointerMove);
                el.addEventListener('pointerup', onPointerUp);
            });
        }

        // Toolbar Actions
        function transformSelected(action, val) {
            if (!selectedItem) return;
            if (action === 'rotate') {
                selectedItem.dataset.rot = (parseFloat(selectedItem.dataset.rot) + val) % 360;
                updateTransform(selectedItem);
            } else if (action === 'scale') {
                let s = parseFloat(selectedItem.dataset.scl) + val;
                if (s < 0.3) s = 0.3;
                if (s > 3) s = 3;
                selectedItem.dataset.scl = s;
                updateTransform(selectedItem);
            } else if (action === 'layer') {
                let z = parseInt(selectedItem.style.zIndex) + val;
                selectedItem.style.zIndex = z;
            }
        }

        function deleteSelected() {
            if (!selectedItem) return;
            selectedItem.remove();
            deselectAll();
        }

        function clearCanvas() {
            document.getElementById('items-layer').innerHTML = '';
            deselectAll();
        }

        // --- 4. Styling Toggles (Pot & BG) ---
        
        function setPot(type) {
            const body = document.getElementById('pot-body');
            const surface = document.getElementById('pot-surface');
            const overlay = document.getElementById('pot-overlay');
            
            body.className = `w-64 h-48 sm:w-80 sm:h-56 -mt-12 sm:-mt-16 z-0 transition-all duration-500 relative flex items-center justify-center overflow-hidden pot-${type}`;
            surface.className = `w-64 h-24 sm:w-80 sm:h-32 relative z-10 overflow-visible flex items-center justify-center transition-all duration-500 border-b-4 border-black/10 pot-${type}-rim`;
            
            if(type === 'glass') overlay.classList.remove('hidden');
            else overlay.classList.add('hidden');
        }

        function setBg(className) {
            const stage = document.getElementById('stage-bg');
            stage.className = `flex-1 relative flex items-center justify-center p-4 overflow-hidden transition-all duration-700 ${className}`;
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('border-zen-700', 'text-zen-800');
                b.classList.add('border-transparent', 'text-zen-500');
            });
            
            document.getElementById(`panel-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('border-zen-700', 'text-zen-800');
            activeBtn.classList.remove('border-transparent', 'text-zen-500');
        }

