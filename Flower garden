<!DOCTYPE html>
<html lang="th" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Zen Flora - Procedural Terrarium</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- html2canvas for High Quality Capture (Script only, no external images) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zen: {
                            50: '#faf9f8',
                            100: '#f4f1ee',
                            200: '#e6dfd7',
                            300: '#d1c7bc',
                            400: '#b8a99b',
                            500: '#a38f7e',
                            600: '#8c7664',
                            700: '#756052',
                            800: '#635348',
                            900: '#53463e',
                        },
                        pastel: {
                            green: '#cce3de',
                            blue: '#a2d2ff',
                            pink: '#ffc8dd',
                            yellow: '#fdf0d5'
                        }
                    },
                    fontFamily: {
                        sans: ['system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            user-select: none;
            -webkit-user-select: none;
            overflow: hidden;
            background-color: #faf9f8;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        /* SVG Item Selection Ring */
        .placed-item {
            touch-action: none;
            cursor: grab;
            position: absolute;
            transform-origin: center center;
            will-change: transform, left, top;
            filter: drop-shadow(0px 8px 12px rgba(0,0,0,0.1));
            transition: filter 0.2s ease;
        }
        .placed-item:active {
            cursor: grabbing;
        }
        .placed-item.selected > svg {
            overflow: visible;
            filter: drop-shadow(0 0 6px rgba(163, 143, 126, 0.6));
            outline: 2px dashed #a38f7e;
            outline-offset: 8px;
            border-radius: 8px;
        }

        /* Procedural Pot Styles */
        .pot-terracotta {
            background: linear-gradient(135deg, #e29578 0%, #b5654b 100%);
            border-radius: 0 0 60px 60px;
            box-shadow: inset -15px -15px 30px rgba(0,0,0,0.2), 0 20px 25px -5px rgba(0,0,0,0.1);
        }
        .pot-terracotta-rim {
            background: #d6876a;
            border-radius: 50%;
            box-shadow: inset 0 -5px 10px rgba(0,0,0,0.1);
        }

        .pot-ceramic {
            background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 100%);
            border-radius: 10px 10px 80px 80px;
            box-shadow: inset -20px -10px 40px rgba(0,0,0,0.1), 0 20px 30px -10px rgba(0,0,0,0.15);
        }
        .pot-ceramic-rim {
            background: #f5f5f5;
            border-radius: 50%;
        }

        .pot-glass {
            background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(200,220,230,0.2) 100%);
            backdrop-filter: blur(4px);
            border-radius: 40px;
            border: 1px solid rgba(255,255,255,0.6);
            box-shadow: inset 10px 10px 20px rgba(255,255,255,0.5), inset -10px -10px 20px rgba(0,0,0,0.1);
        }
        .pot-glass-rim {
            background: rgba(255,255,255,0.2);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 50%;
        }

        /* Procedural Backgrounds */
        .bg-grid {
            background-color: #faf9f8;
            background-image: radial-gradient(#d1c7bc 1px, transparent 1px);
            background-size: 20px 20px;
        }
        .bg-gradient-mesh {
            background-color: #ffc8dd;
            background-image: 
                radial-gradient(at 40% 20%, #a2d2ff 0px, transparent 50%),
                radial-gradient(at 80% 0%, #cce3de 0px, transparent 50%),
                radial-gradient(at 0% 50%, #fdf0d5 0px, transparent 50%);
        }
        .bg-zen-circle {
            background-color: #f4f1ee;
            background-image: radial-gradient(circle at 50% 50%, #e6dfd7 0%, #e6dfd7 35%, transparent 35.5%);
        }

        /* New Procedural Backgrounds */
        .bg-sunset-glow {
            background: linear-gradient(135deg, #ffc8dd 0%, #fdf0d5 50%, #cce3de 100%);
        }
        .bg-lavender-haze {
            background-color: #f3e8ff;
            background-image: 
                radial-gradient(at 20% 80%, #ffc8dd 0px, transparent 50%), 
                radial-gradient(at 80% 20%, #cce3de 0px, transparent 50%);
        }
        .bg-polka-pastel {
            background-color: #faf9f8;
            background-image: radial-gradient(#a2d2ff 2.5px, transparent 2.5px);
            background-size: 25px 25px;
        }
        .bg-aurora {
            background: linear-gradient(120deg, #a8edea 0%, #fed6e3 100%);
        }
        .bg-wavy-sand {
            background-color: #fdf0d5;
            background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(163, 143, 126, 0.04) 10px, rgba(163, 143, 126, 0.04) 20px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #d1c7bc; border-radius: 4px; }
    </style>
</head>
