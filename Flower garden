        let currentLang = 'en';
        function toggleLanguage() {
            currentLang = currentLang === 'en' ? 'th' : 'en';
            document.getElementById('langLabel').innerText = currentLang === 'en' ? 'EN / TH' : 'TH / EN';
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[currentLang][key]) {
                    el.innerText = dict[currentLang][key];
                }
            });
        }

        // --- 6. Snapshot Feature (using html2canvas logic) ---
        function captureCanvas() {
            deselectAll(); // Remove UI lines
            const target = document.getElementById('canvas-container');
            
            html2canvas(target, {
                backgroundColor: null,
                scale: 2 // High res
            }).then(canvas => {
                const preview = document.getElementById('capture-preview');
                preview.innerHTML = '';
                
                const img = document.createElement('img');
                img.src = canvas.toDataURL('image/png');
                img.className = 'max-h-64 object-contain filter drop-shadow-lg';
                preview.appendChild(img);

                const link = document.getElementById('download-btn');
                link.href = canvas.toDataURL('image/png');
                link.download = `zen-flora-${Date.now()}.png`;

                const modal = document.getElementById('modal-capture');
                const content = document.getElementById('modal-content');
                modal.classList.remove('hidden');
                // Trigger reflow
                void modal.offsetWidth;
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
            });
        }

        function closeModal() {
            const modal = document.getElementById('modal-capture');
            const content = document.getElementById('modal-content');
            modal.classList.add('opacity-0');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Init language UI
        toggleLanguage();
        toggleLanguage(); // Trigger re-render to english
        
        // Auto-generate one plant on start
        setTimeout(() => generateAndPlace('eucalyptus'), 500);

    </script>
